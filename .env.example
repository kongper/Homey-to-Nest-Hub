# Copy this file to ".env" and fill in your values.

# Your Homey's local address. Either the LAN IP or the mDNS name.
#   Example IP:   http://192.168.1.50
#   Example mDNS: http://homey-xxxxxxxxxxxxxxxxxxxxxxxx.local
HOMEY_ADDRESS=http://192.168.1.50

# Personal Access Token (API Key) created in the Homey Web App:
#   https://my.homey.app  ->  Settings -> API Keys -> create key
# Give it at least read access to Devices and Zones.
HOMEY_TOKEN=paste-your-personal-access-token-here

# Port the dashboard listens on (inside the container).
PORT=3000

# How long (seconds) to cache Homey data before refetching. Keeps load off Homey.
CACHE_TTL=5
