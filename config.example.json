{
  "title": "Home Dashboard",
  "entities": {
    "weather": [
      {
        "deviceId": "YR-DEVICE-ID",
        "label": "Vær ute",
        "capabilities": ["measure_temperature", "weather_description"]
      }
    ],
    "big": [
      {
        "deviceId": "OUTDOOR-TEMP-DEVICE-ID",
        "label": "Temp ute",
        "capabilities": ["measure_temperature"]
      }
    ],
    "small": [
      {
        "deviceId": "DOOR-DEVICE-ID",
        "label": "Front door",
        "capabilities": ["alarm_contact"]
      }
    ],
    "slider": [
      {
        "label": "Utestue zip",
        "deviceIds": [
          { "name": "Zip sør",  "id": "ZIP-SCREEN-1-DEVICE-ID", "max": 97 },
          { "name": "Zip vest", "id": "ZIP-SCREEN-2-DEVICE-ID" }
        ],
        "step": 5
      }
    ],
    "list": [
      {
        "deviceId": "DISHWASHER-DEVICE-ID",
        "label": "Oppvask",
        "capabilities": ["remaining_time"],
        "showIf": "!=empty"
      },
      {
        "deviceId": "MULTI-CAP-DEVICE-ID",
        "label": "Living room sensor",
        "capabilities": ["measure_temperature", "measure_humidity", "measure_co2"]
      },
      {
        "deviceId": "BATTERY-DEVICE-ID",
        "label": "Lavt batteri",
        "capabilities": ["measure_battery"],
        "showIf": "<20"
      }
    ]
